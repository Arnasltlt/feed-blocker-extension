{
  "manifest_version": 3,
  "name": "Feed Blocker - YouTube Home",
  "description": "Removes the YouTube home page recommendation feed.",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.facebook.com/*",
    "https://www.messenger.com/*",
    "https://feed-blocking-server.fly.dev/*",
    "http://127.0.0.1:11400/*",
    "http://localhost:11400/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fb_messages_block",
        "enabled": true,
        "path": "fb-messages-block-rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Feed Recommendation Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "recommendation-tracker.js",
        "local-ai.js",
        "youtube-home-blocker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "recommendation-tracker.js",
        "linkedin-feed-blocker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "recommendation-tracker.js",
        "x-feed-blocker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/messages*"
      ],
      "css": [
        "facebook-messages-header-blocker.css"
      ],
      "js": [
        "facebook-messages-header-blocker.js"
      ],
      "run_at": "document_start"
    }
  ]
}